# Copy this file to automation/.env and fill in the values.
# Never commit the real .env file: the service role key bypasses Row Level Security.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (secret). Used only by these server-side scripts, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- EmailJS (https://dashboard.emailjs.com) ---
# Email Services > your service ID
EMAILJS_SERVICE_ID=
# Email Templates > template ID. The template must use {{to_email}}, {{to_name}},
# {{from_name}}, {{reply_to}}, {{subject}} and {{{html_body}}} (triple braces = raw HTML).
EMAILJS_TEMPLATE_ID=
# Account > General > Public Key
EMAILJS_PUBLIC_KEY=
# Account > General > Private Key. Also enable "Allow EmailJS API for non-browser
# applications" under Account > Security, otherwise every send returns 403.
EMAILJS_PRIVATE_KEY=

# --- Studio identity (used in emails and the daily digest) ---
OWNER_NAME=Ritesh Farswan
# Where the daily digest goes, and the reply-to address on client emails.
OWNER_EMAIL=hello@riteshfarswan.com
OWNER_PHONE=+91 98200 00000
# Optional: shown in the email header and footer.
STUDIO_NAME=Ritesh Farswan Photography
OWNER_CITY=Mumbai

# --- Links ---
SITE_URL=https://riteshfarswan.com
# Gallery links are built as CLIENT_PORTAL_URL + "gallery.html?id=<gallery id>".
CLIENT_PORTAL_URL=https://riteshfarswan.com/client/
# Google review link (or any review page). Leave empty to omit it from thank-you emails.
REVIEW_URL=

# --- Timing ---
# Send the session reminder this many days before the event date.
REMINDER_DAYS_BEFORE=3
# Send the thank-you / review request this many days after the event date.
FOLLOWUP_DAYS_AFTER=21
# Warn clients this many days before their gallery expires.
EXPIRY_WARNING_DAYS=7
# IANA time zone used for "today" and for the scheduler clock.
TIMEZONE=Asia/Kolkata

# --- Housekeeping ---
# Relative paths are resolved from the automation/ folder.
BACKUP_DIR=./backups
# true = log emails instead of sending them and skip all database / storage writes.
DRY_RUN=false
